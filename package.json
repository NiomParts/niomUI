{
  "name": "niom-parts",
  "version": "0.2.3",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/styles/index.css",
    "./css": "./dist/styles/index.css",
    "./css/index.css": "./dist/styles/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "vite",
    "storybook",
    "tailwindcss",
    "react"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "author": "Nomekuma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiomParts/niomUI.git"
  },
  "homepage": "https://docs.niomparts.com",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "motion": "^12.38.0",
    "tailwind-merge": "^3.5.0"
  },
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dev": "npm run build:docs && docusaurus serve --port 3000",
    "dev:en": "docusaurus start --locale en --port 3000",
    "dev:fr": "docusaurus start --locale fr --port 3001",
    "preview:docs": "npm run build:docs && docusaurus serve --port 3001",
    "playground": "vite",
    "test": "vitest run",
    "build:css": "tailwindcss -i src/css/index.css -o dist/styles/index.css --minify",
    "build": "npm run build:docs",
    "build:docs": "docusaurus build",
    "build:package": "npm run test && tsup && npm run build:css",
    "serve": "docusaurus serve",
    "prepublishOnly": "npm run build:package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@cmfcmf/docusaurus-search-local": "^2.0.1",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-live-codeblock": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.12",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.4",
    "tsup": "^8.5.1",
    "vitest": "^4.1.5"
  }
}
